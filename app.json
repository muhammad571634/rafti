{
  "expo": {
    "name": "Sigmazam",
    "slug": "rafti",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rafti",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rafti.app",
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF7EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 240
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EF8A4E",
          "sounds": [
            "./assets/sounds/alarms/morning_tide.wav",
            "./assets/sounds/alarms/shell_chimes.wav",
            "./assets/sounds/alarms/sea_breeze.wav",
            "./assets/sounds/alarms/soft_bells.wav",
            "./assets/sounds/alarms/lighthouse.wav"
          ]
        }
      ],
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {}
  }
}
