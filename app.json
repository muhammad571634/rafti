{
  "expo": {
    "name": "Sigmazam",
    "slug": "sigmazam",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigmazam",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CFBundleLocalizations": [
          "en",
          "es",
          "pt-BR",
          "fr",
          "de",
          "it",
          "ja",
          "ko",
          "zh-Hant",
          "id",
          "vi",
          "th",
          "ru",
          "tr"
        ]
      }
    },
    "android": {
      "package": "com.sigmazam.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#FDF6EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_FULL_SCREEN_INTENT",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF6F1",
          "dark": {
            "backgroundColor": "#05060F"
          }
        }
      ],
      "expo-localization",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#EF8A4E",
          "sounds": [
            "./assets/sounds/alarms/morning_tide.wav",
            "./assets/sounds/alarms/shell_chimes.wav",
            "./assets/sounds/alarms/sea_breeze.wav",
            "./assets/sounds/alarms/soft_bells.wav",
            "./assets/sounds/alarms/lighthouse.wav"
          ]
        }
      ],
      "expo-audio",
      "@react-native-community/datetimepicker",
      "expo-asset",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {},
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2280e30a-4e30-447f-9d62-078d6b58a619"
      }
    },
    "owner": "sukuts-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/2280e30a-4e30-447f-9d62-078d6b58a619"
    }
  }
}
