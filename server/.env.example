# Copy to server/.env.local (git-ignored) and fill in. Never commit keys or paste them in a chat.

# Google AI Studio key (https://aistudio.google.com/apikey). Use a project WITHOUT billing to stay
# on the free tier: requests are free, capped per day, and Google may use them to improve its models.
GEMINI_API_KEY=

# Optional: an OpenAI-compatible provider, tried before Gemini (DeepSeek, OpenRouter, Groq…)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-chat
# OPENAI_LABEL=deepseek

# Supabase (accounts, wallet, plans): the cloud project "rafti sigmazam" only, no local Docker stack.
# On the owner's laptop these are Windows user environment variables, not in any file. Values:
# Dashboard → Settings → API keys. The publishable key is handed to the app by /v1/client-config.
# SUPABASE_URL=https://yhelqgpwputlayawwtne.supabase.co
# SUPABASE_SECRET_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# The laptop test server only: the app may credit earnings whose rules are not on the server yet.
# DEV_GRANTS=1

# Optional
# CHAT_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview,gemini-flash-latest
# PORT=8787
