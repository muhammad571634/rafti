# Copy to server/.env.local (git-ignored) and fill in. Never commit keys or paste them in a chat.

# Google AI Studio key (https://aistudio.google.com/apikey). Use a project WITHOUT billing to stay
# on the free tier: requests are free, capped per day, and Google may use them to improve its models.
GEMINI_API_KEY=

# Optional: an OpenAI-compatible provider, tried before Gemini (DeepSeek, OpenRouter, Groq…)
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=deepseek-chat
# OPENAI_LABEL=deepseek

# Optional
# CHAT_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash,gemini-flash-latest
# PORT=8787
